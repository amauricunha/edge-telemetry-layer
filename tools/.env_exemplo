# Configurações do InfluxDB
INFLUX_URL="http://localhost:8897"
INFLUX_TOKEN="your-influx-token-here"
INFLUX_ORG="telemetry_org"
INFLUX_BUCKET="telemetry"
INFLUX_MEASUREMENT="telemetry"

# Filtro de tempo (Formato ISO 8601 com fuso horário)
INFLUX_START="2026-08-11T14:00:00-03:00"
INFLUX_END="2026-08-11T14:30:00-03:00"

# Configurações do Broker MQTT (tools/send_command.py)
MQTT_BROKER_IP="127.0.0.1"
MQTT_BROKER_PORT=1883
MQTT_USER=""
MQTT_PASS=""