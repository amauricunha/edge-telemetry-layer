
--Historically
node H(X:bool) returns (Y:bool);
let Y = X -> (X and (pre Y)); tel

node OTlore( N: int; X: bool) returns (Y: bool);
var C:int;
let
    C = if X then 0 else (-1 -> pre C + (if pre C <0 then 0 else 1));
    Y = 0 <= C and C <= N;
tel

node delay(X: bool; const R: int) returns (Y: bool);
var D: bool;
let
  D = false -> pre X;
  Y = D;
tel

node OT( L: int;  R: int; X: bool) returns (Y: bool);
var D:bool;
let
  D=delay(X, R);
  Y=OTlore(L-R, D);
tel

node imported testSpec( in_sig: bool ) returns ( out_sig: bool );
(*@contract
  var __REQ : bool = H(in_sig => OT(500, 500, out_sig));
  guarantee __REQ;
*)
