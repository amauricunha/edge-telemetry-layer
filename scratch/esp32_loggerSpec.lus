
--Historically
node H(X:bool) returns (Y:bool);
let
    Y = X -> (X and (pre Y));
tel

--Y since inclusive X
node SI(X,Y: bool) returns (Z:bool);
let
Z = Y and (X or (false -> pre Z));
tel

--Y since X
node S(X,Y: bool) returns (Z:bool);
let
Z = X or (Y and (false -> pre Z));
tel

--Y triggered X
node T(X,Y: bool) returns(Z:bool);
let
Z = (X and (Y or (true -> pre Z)));
tel

--Once
node O(X:bool) returns (Y:bool);
let
 Y = X or (false -> pre Y);
tel

node YtoPre(X:bool) returns (Y:bool);
let
    Y = false -> pre X;
tel

node ZtoPre(X:bool) returns (Y:bool);
let
    Y = true -> pre X;
tel


node imported esp32_loggerSpec( __csv_line_available:boolean ; __flush_timer_2s_expired:boolean ; __heartbeat_timer_60s:boolean ; __memory_supervision_active:boolean ; __sd_write_failed:boolean ; __sector_write_chunk:boolean ; __telemetry_frame_received:boolean ) returns ( __chunk_preemption_yielded:boolean ; __csv_line_formatted:boolean ; __dataset_recording:boolean ; __flush_signal_emitted:boolean ; __heartbeat_diag_logged:boolean ; __null_mandatory_fields:integer ; __pending_bytes_flushed:boolean ; __ram_backlog_retained:boolean ; __sd_buffer_pushed:boolean ; __sram_usage_kb:real );
(*@contract

var __FTP : bool = true -> false;

var __active_session : boolean = true;
var __buffer_occupancy : integer = 0;
var __offline_mode : boolean = false;

(* Req text: in active_session when buffer_occupancy >= 3584 the esp32_logger shall immediately satisfy flush_signal_emitted *)
var __REQ_LOG_004 : bool = (H(((not (__active_session) and YtoPre(__active_session)) => YtoPre(SI((__active_session and ZtoPre(not (__active_session))),(((__buffer_occupancy >= 3584) and (YtoPre(not ((__buffer_occupancy >= 3584))) or (__active_session and ZtoPre(not (__active_session))))) => __flush_signal_emitted))))) and (SI((__active_session and ZtoPre(not (__active_session))),not ((not (__active_session) and YtoPre(__active_session)))) => SI((__active_session and ZtoPre(not (__active_session))),(((__buffer_occupancy >= 3584) and (YtoPre(not ((__buffer_occupancy >= 3584))) or (__active_session and ZtoPre(not (__active_session))))) => __flush_signal_emitted))));

(* Req text: in active_session upon flush_timer_2s_expired the esp32_logger shall within 10 MILLISECOND satisfy pending_bytes_flushed *)
var __REQ_LOG_005 : bool = (H(((not (__active_session) and YtoPre(__active_session)) => YtoPre(SI((__active_session and ZtoPre(not (__active_session))),(OT(10, 10, ((__flush_timer_2s_expired and (YtoPre(not (__flush_timer_2s_expired)) or (__active_session and ZtoPre(not (__active_session))))) and not (__pending_bytes_flushed))) => OT(9, 0, ((__active_session and ZtoPre(not (__active_session))) or __pending_bytes_flushed))))))) and (SI((__active_session and ZtoPre(not (__active_session))),not ((not (__active_session) and YtoPre(__active_session)))) => SI((__active_session and ZtoPre(not (__active_session))),(OT(10, 10, ((__flush_timer_2s_expired and (YtoPre(not (__flush_timer_2s_expired)) or (__active_session and ZtoPre(not (__active_session))))) and not (__pending_bytes_flushed))) => OT(9, 0, ((__active_session and ZtoPre(not (__active_session))) or __pending_bytes_flushed))))));

(* Req text: in active_session upon telemetry_frame_received the esp32_logger shall within 1 MILLISECOND satisfy csv_line_formatted *)
var __REQ_LOG_001 : bool = (H(((not (__active_session) and YtoPre(__active_session)) => YtoPre(SI((__active_session and ZtoPre(not (__active_session))),(OT(1, 1, ((__telemetry_frame_received and (YtoPre(not (__telemetry_frame_received)) or (__active_session and ZtoPre(not (__active_session))))) and not (__csv_line_formatted))) => OT(0, 0, ((__active_session and ZtoPre(not (__active_session))) or __csv_line_formatted))))))) and (SI((__active_session and ZtoPre(not (__active_session))),not ((not (__active_session) and YtoPre(__active_session)))) => SI((__active_session and ZtoPre(not (__active_session))),(OT(1, 1, ((__telemetry_frame_received and (YtoPre(not (__telemetry_frame_received)) or (__active_session and ZtoPre(not (__active_session))))) and not (__csv_line_formatted))) => OT(0, 0, ((__active_session and ZtoPre(not (__active_session))) or __csv_line_formatted))))));

(* Req text: in active_session upon sector_write_chunk the esp32_logger shall within 1 MILLISECOND satisfy chunk_preemption_yielded *)
var __REQ_LOG_006 : bool = (H(((not (__active_session) and YtoPre(__active_session)) => YtoPre(SI((__active_session and ZtoPre(not (__active_session))),(OT(1, 1, ((__sector_write_chunk and (YtoPre(not (__sector_write_chunk)) or (__active_session and ZtoPre(not (__active_session))))) and not (__chunk_preemption_yielded))) => OT(0, 0, ((__active_session and ZtoPre(not (__active_session))) or __chunk_preemption_yielded))))))) and (SI((__active_session and ZtoPre(not (__active_session))),not ((not (__active_session) and YtoPre(__active_session)))) => SI((__active_session and ZtoPre(not (__active_session))),(OT(1, 1, ((__sector_write_chunk and (YtoPre(not (__sector_write_chunk)) or (__active_session and ZtoPre(not (__active_session))))) and not (__chunk_preemption_yielded))) => OT(0, 0, ((__active_session and ZtoPre(not (__active_session))) or __chunk_preemption_yielded))))));

(* Req text: in offline_mode upon sd_write_failed the esp32_logger shall within 2 MILLISECOND satisfy ram_backlog_retained *)
var __REQ_LOG_007 : bool = (H(((not (__offline_mode) and YtoPre(__offline_mode)) => YtoPre(SI((__offline_mode and ZtoPre(not (__offline_mode))),(OT(2, 2, ((__sd_write_failed and (YtoPre(not (__sd_write_failed)) or (__offline_mode and ZtoPre(not (__offline_mode))))) and not (__ram_backlog_retained))) => OT(1, 0, ((__offline_mode and ZtoPre(not (__offline_mode))) or __ram_backlog_retained))))))) and (SI((__offline_mode and ZtoPre(not (__offline_mode))),not ((not (__offline_mode) and YtoPre(__offline_mode)))) => SI((__offline_mode and ZtoPre(not (__offline_mode))),(OT(2, 2, ((__sd_write_failed and (YtoPre(not (__sd_write_failed)) or (__offline_mode and ZtoPre(not (__offline_mode))))) and not (__ram_backlog_retained))) => OT(1, 0, ((__offline_mode and ZtoPre(not (__offline_mode))) or __ram_backlog_retained))))));

(* Req text: in active_session when memory_supervision_active the esp32_logger shall always satisfy sram_usage_kb < 200.0 *)
var __REQ_LOG_008 : bool = (H(((not (__active_session) and YtoPre(__active_session)) => YtoPre(SI((__active_session and ZtoPre(not (__active_session))),(SI((__active_session and ZtoPre(not (__active_session))),not (__memory_supervision_active)) or (__sram_usage_kb < 200.0)))))) and (SI((__active_session and ZtoPre(not (__active_session))),not ((not (__active_session) and YtoPre(__active_session)))) => SI((__active_session and ZtoPre(not (__active_session))),(SI((__active_session and ZtoPre(not (__active_session))),not (__memory_supervision_active)) or (__sram_usage_kb < 200.0)))));

(* Req text: in active_session upon heartbeat_timer_60s the esp32_logger shall within 10 MILLISECOND satisfy heartbeat_diag_logged *)
var __REQ_LOG_009 : bool = (H(((not (__active_session) and YtoPre(__active_session)) => YtoPre(SI((__active_session and ZtoPre(not (__active_session))),(OT(10, 10, ((__heartbeat_timer_60s and (YtoPre(not (__heartbeat_timer_60s)) or (__active_session and ZtoPre(not (__active_session))))) and not (__heartbeat_diag_logged))) => OT(9, 0, ((__active_session and ZtoPre(not (__active_session))) or __heartbeat_diag_logged))))))) and (SI((__active_session and ZtoPre(not (__active_session))),not ((not (__active_session) and YtoPre(__active_session)))) => SI((__active_session and ZtoPre(not (__active_session))),(OT(10, 10, ((__heartbeat_timer_60s and (YtoPre(not (__heartbeat_timer_60s)) or (__active_session and ZtoPre(not (__active_session))))) and not (__heartbeat_diag_logged))) => OT(9, 0, ((__active_session and ZtoPre(not (__active_session))) or __heartbeat_diag_logged))))));

(* Req text: in active_session when dataset_recording the esp32_logger shall always satisfy null_mandatory_fields = 0 *)
var __REQ_LOG_002 : bool = (H(((not (__active_session) and YtoPre(__active_session)) => YtoPre(SI((__active_session and ZtoPre(not (__active_session))),(SI((__active_session and ZtoPre(not (__active_session))),not (__dataset_recording)) or (__null_mandatory_fields = 0)))))) and (SI((__active_session and ZtoPre(not (__active_session))),not ((not (__active_session) and YtoPre(__active_session)))) => SI((__active_session and ZtoPre(not (__active_session))),(SI((__active_session and ZtoPre(not (__active_session))),not (__dataset_recording)) or (__null_mandatory_fields = 0)))));

(* Req text: in active_session upon csv_line_available the esp32_logger shall within 1 MILLISECOND satisfy sd_buffer_pushed *)
var __REQ_LOG_003 : bool = (H(((not (__active_session) and YtoPre(__active_session)) => YtoPre(SI((__active_session and ZtoPre(not (__active_session))),(OT(1, 1, ((__csv_line_available and (YtoPre(not (__csv_line_available)) or (__active_session and ZtoPre(not (__active_session))))) and not (__sd_buffer_pushed))) => OT(0, 0, ((__active_session and ZtoPre(not (__active_session))) or __sd_buffer_pushed))))))) and (SI((__active_session and ZtoPre(not (__active_session))),not ((not (__active_session) and YtoPre(__active_session)))) => SI((__active_session and ZtoPre(not (__active_session))),(OT(1, 1, ((__csv_line_available and (YtoPre(not (__csv_line_available)) or (__active_session and ZtoPre(not (__active_session))))) and not (__sd_buffer_pushed))) => OT(0, 0, ((__active_session and ZtoPre(not (__active_session))) or __sd_buffer_pushed))))));

guarantee __REQ_LOG_004;
guarantee __REQ_LOG_005;
guarantee __REQ_LOG_001;
guarantee __REQ_LOG_006;
guarantee __REQ_LOG_007;
guarantee __REQ_LOG_008;
guarantee __REQ_LOG_009;
guarantee __REQ_LOG_002;
guarantee __REQ_LOG_003;

*)
