package Storage_Devices_Pkg
public
	with Buses_Pkg;
	with Data_Types_Pkg;
	renames Buses_Pkg::all;

	---------------------------------------------------------------------------
	-- PILAR 2: MODELAGEM DOS DISPOSITIVOS DE ARMAZENAMENTO (STORAGE DEVICE)
	--
	-- Papel Semântico no AADL:
	-- Representa a mídia física não volátil de persistência de dados.
	-- Atua como 'flow sink' (ralo de dados) para o fluxo de telemetria CAN->SD.
	--
	-- Rastreabilidade com Requisitos:
	-- - REQ-SYS-16 / REQ_SD_001: Montagem FAT32 no SPI2
	-- - REQ-SYS-17 / REQ_SD_002: Ciclo de vida atômico de sessões (S_XXXX.CSV)
	-- - REQ-SYS-18 / REQ_SD_005: Volume cumulativo >= 72.000 amostras
	-- - Critério de Aceitação: AC-03 (Zero corrupção de dados após corte de energia)
	---------------------------------------------------------------------------

	---------------------------------------------------------------------------
	-- 1. DISPOSITIVO PADRÃO: Cartão MicroSD FAT32 via SPI (Baseline)
	--
	-- Hardware Real: Cartão SanDisk / Kingston MicroSDHC Classe 10 conectado via SPI2
	-- Temporização:
	-- - Período de ciclo: 50 ms (Compatível com o período da Task_TX_Dispatch)
	-- - No cálculo de latência do OSATE, contribui com o deadline de escrita
	--   física de setor NAND Flash (50 ms no pior caso).
	---------------------------------------------------------------------------
	device MicroSD_Device
		features
			spi_conn: requires bus access SPI_Bus;
			file_stream_in: in event data port Data_Types_Pkg::CSV_Payload_Data;
		flows
			f_sink: flow sink file_stream_in;
		properties
			Dispatch_Protocol => Periodic;
			Period => 50 ms;
	end MicroSD_Device;

	device implementation MicroSD_Device.impl
	end MicroSD_Device.impl;

	---------------------------------------------------------------------------
	-- 2. DISPOSITIVO CANDIDATO (Pilar 4 - CAvA / DevCompatibility): Flash NOR/NAND Direta
	--
	-- Cenário de Evolução Arquitetural:
	-- Substituição do MicroSD por memória Flash SPI dedicada (ex: Winbond W25Q128).
	--
	-- Quebras de Compatibilidade com o Baseline:
	-- - Período reduzido de 50 ms para 20 ms (maior velocidade de ciclo);
	-- - Adição de porta de evento 'write_complete_event' para notificação assíncrona;
	-- - Utilizado na ferramenta DevCompatibility do Prof. Becker para provar
	--   a detecção automática de desvios de interface.
	---------------------------------------------------------------------------
	device HighSpeed_Flash_Device
		features
			spi_conn: requires bus access SPI_Bus;
			raw_block_stream_in: in event data port Data_Types_Pkg::CSV_Payload_Data;
			write_complete_event: out event port;
		flows
			f_sink: flow sink raw_block_stream_in;
		properties
			Dispatch_Protocol => Periodic;
			Period => 20 ms;
	end HighSpeed_Flash_Device;

	device implementation HighSpeed_Flash_Device.impl
	end HighSpeed_Flash_Device.impl;

end Storage_Devices_Pkg;
