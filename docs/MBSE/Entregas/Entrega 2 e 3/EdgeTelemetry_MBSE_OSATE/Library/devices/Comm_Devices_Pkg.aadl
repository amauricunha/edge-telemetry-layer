package Comm_Devices_Pkg
public
	with Data_Types_Pkg;

	---------------------------------------------------------------------------
	-- PILAR 2: MODELAGEM DOS DISPOSITIVOS DE COMUNICAÇÃO REMOTA (COMM DEVICE)
	--
	-- Papel Semântico no AADL:
	-- Representa o gateway físico de telemetria sem fio para envio de dados
	-- a corretores MQTT na nuvem (Broker AWS IoT / Mosquitto).
	--
	-- Rastreabilidade com Requisitos e Critérios:
	-- - REQ-SYS-21 / REQ_FSM_001: Conectividade Wi-Fi e publicação MQTT
	-- - REQ-SYS-25 / REQ_CMD_001: Processamento de comandos remotos de bancada
	-- - Critério de Aceitação: AC-05 (Detecção de desconexão e reconexão em <= 5 s)
	---------------------------------------------------------------------------

	---------------------------------------------------------------------------
	-- 1. DISPOSITIVO PADRÃO: Rádio Wi-Fi 802.11 b/g/n / MQTT (Baseline)
	--
	-- Hardware Real: Rádio Wi-Fi nativo de 2.4 GHz integrado ao SoC ESP32-S3
	-- Papel no Fluxo: Atua como 'flow sink' no fluxo ponta a ponta end_to_end_can_to_mqtt.
	-- Portas:
	-- - mqtt_stream_in: Ingestão de linhas CSV de telemetria tradicional
	-- - coaching_stream_in: Ingestão dos pacotes de Driver Coaching (Pilar 4)
	---------------------------------------------------------------------------
	device WiFi_Device
		features
			mqtt_stream_in: in event data port Data_Types_Pkg::CSV_Payload_Data;
			coaching_stream_in: in event data port Data_Types_Pkg::Driver_Coaching_Data;
		flows
			f_sink_telemetry: flow sink mqtt_stream_in;
			f_sink_coaching: flow sink coaching_stream_in;
		properties
			Dispatch_Protocol => Periodic;
			Period => 50 ms;
	end WiFi_Device;

	device implementation WiFi_Device.impl
	end WiFi_Device.impl;

	---------------------------------------------------------------------------
	-- 2. DISPOSITIVO CANDIDATO (Pilar 4 - CAvA / DevCompatibility): Modem Celular 4G/LTE
	--
	-- Cenário de Evolução Arquitetural:
	-- Modernização do sistema para operação remota em veículos de frota aberta,
	-- substituindo a cobertura Wi-Fi local por telemetria celular (SIMCom / Quectel).
	--
	-- Quebras de Compatibilidade com o Baseline:
	-- - Período de ciclo aumentado de 50 ms para 100 ms (latência maior da rede celular);
	-- - Adição de porta de diagnóstico de rede 'network_status_out' (sinal CSQ / RSRP);
	-- - Avaliado no Pilar 4 através da matriz de compatibilidade do Framework CAvA.
	---------------------------------------------------------------------------
	device Cellular_LTE_Device
		features
			cellular_stream_in: in event data port Data_Types_Pkg::CSV_Payload_Data;
			coaching_stream_in: in event data port Data_Types_Pkg::Driver_Coaching_Data;
			network_status_out: out event data port Data_Types_Pkg::Diagnostic_Packet_Data;
		flows
			f_sink_telemetry: flow sink cellular_stream_in;
			f_sink_coaching: flow sink coaching_stream_in;
		properties
			Dispatch_Protocol => Periodic;
			Period => 100 ms;
	end Cellular_LTE_Device;

	device implementation Cellular_LTE_Device.impl
	end Cellular_LTE_Device.impl;

end Comm_Devices_Pkg;
