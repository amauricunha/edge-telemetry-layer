% --- Comando Seguro para Inclusão de Imagem ---
\newcommand{\includegraphicssafe}[3]{%
  \IfFileExists{#2}{%
    \includegraphics[#1]{#2}%
  }{%
    \IfFileExists{sections/Imagens/#2}{%
      \includegraphics[#1]{sections/Imagens/#2}%
    }{%
      \IfFileExists{Imagens/#2}{%
        \includegraphics[#1]{Imagens/#2}%
      }{%
        \IfFileExists{images/#2}{%
          \includegraphics[#1]{images/#2}%
        }{%
          \begin{center}
            \fbox{\parbox{0.9\linewidth}{\centering \textbf{[Imagem: #2]}\\\small #3}}
          \end{center}
        }%
      }%
    }%
  }%
}
