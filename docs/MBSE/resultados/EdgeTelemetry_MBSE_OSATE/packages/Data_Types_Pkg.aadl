package Data_Types_Pkg
public

	-- Quadro CAN padronizado (8 bytes payload + 4 bytes ID + DLC + Flags)
	data CAN_Frame_Data
		properties
			Data_Size => 16 Bytes;
	end CAN_Frame_Data;

	-- Pacote de Diagnóstico OBD-II ISO 15765-4 (Single Frame)
	data Diagnostic_Packet_Data
		properties
			Data_Size => 8 Bytes;
	end Diagnostic_Packet_Data;

	-- Linha tabular CSV formatada em buffer estático de memória
	data CSV_Payload_Data
		properties
			Data_Size => 320 Bytes;
	end CSV_Payload_Data;

	-- Vetor de características extraídas (Janela temporal de 100 amostras normalizadas)
	data Feature_Tensor_Data
		properties
			Data_Size => 64 Bytes; -- 8 variáveis x float (RPM, Speed, Throttle, Load, Accel_Y, Brake_Deriv, etc.)
	end Feature_Tensor_Data;

	-- Pacote semântico de recomendação ao motorista (Driver Coaching)
	data Driver_Coaching_Data
		properties
			Data_Size => 32 Bytes; -- Score (0-100), Perfil Predito, Código de Alerta e Ação Sugerida
	end Driver_Coaching_Data;

end Data_Types_Pkg;
