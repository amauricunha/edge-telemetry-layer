package Sistema_Pkg
public
	with Base_Types;

	---------------------------------------------------------------------------
	-- 1. BARRAMENTO FÍSICO CAN
	---------------------------------------------------------------------------
	bus CAN_Bus
	end CAN_Bus;

	---------------------------------------------------------------------------
	-- 2. EMULADOR ARDUINO UNO (SUBSISTEMA 1 - REQUISITOS REQ_EMU_001 A 008)
	---------------------------------------------------------------------------
	system Uno_ECU_Emulator
		features
			-- Conexão de Hardware (Barramento CAN)
			can_bus_conn: requires bus access CAN_Bus;

			-- Entradas Lógicas (Input Variables do FRET)
			boot_trigger: in data port Base_Types::Boolean;
			mcp2515_hardware_up: in data port Base_Types::Boolean;
			profile_cmd_0x010_received: in data port Base_Types::Boolean;
			commanded_profile: in data port Base_Types::Integer;
			timer1_50ms_tick: in data port Base_Types::Boolean;
			timer2_1ms_tick: in data port Base_Types::Boolean;
			obd_request_0x7df_received: in data port Base_Types::Boolean;
			obd_benchmark_running: in data port Base_Types::Boolean;

			-- Saídas Lógicas (Output Variables do FRET)
			can_bus_operational: out data port Base_Types::Boolean;
			active_profile: out data port Base_Types::Integer;
			physics_model_updated: out data port Base_Types::Boolean;
			speed_kmh: out data port Base_Types::Float;
			rpm: out data port Base_Types::Integer;
			throttle_pct: out data port Base_Types::Float;
			load_pct: out data port Base_Types::Float;
			maf_g_s: out data port Base_Types::Float;
			coolant_temp_c: out data port Base_Types::Float;
			dbc_frames_emitted: out data port Base_Types::Boolean;
			mcp2515_rx_polled: out data port Base_Types::Boolean;
			obd_response_0x7e8_sent: out data port Base_Types::Boolean;
			mean_obd_latency_ms: out data port Base_Types::Float;
			latency_jitter_std_ms: out data port Base_Types::Float;

		-- ANEXO AGREE: FORMALIZAÇÃO DOS REQUISITOS DO FRET (REQ_EMU_001 a REQ_EMU_008)
		annex agree {**
			-- Variáveis Internas do FRET (Role: Internal)
			eq boot_mode : bool;
			eq active_session : bool;

			-- REQ_EMU_001: Inicialização do MCP2515 e Perfil Padrão
			guarantee "REQ_EMU_001_Boot":
				(boot_mode and boot_trigger and mcp2515_hardware_up) => 
					(can_bus_operational and active_profile = 2);

			-- REQ_EMU_002: Comutação de Perfil de Condução Simulada
			guarantee "REQ_EMU_002_Profile_Switch":
				(active_session and profile_cmd_0x010_received) => 
					(active_profile = commanded_profile);

			-- REQ_EMU_003: Atualização do Modelo Físico da ECU e Invariantes Válidos
			guarantee "REQ_EMU_003_Physics_Update":
				(active_session and active_profile >= 1 and timer1_50ms_tick) => 
					(physics_model_updated and 
					 speed_kmh >= 0.0 and 
					 rpm >= 0 and 
					 throttle_pct >= 0.0 and 
					 load_pct >= 0.0 and 
					 maf_g_s >= 0.0 and 
					 coolant_temp_c >= -40.0);

			-- REQ_EMU_004: Emissão Cíclica de Grandezas do Motor DBC
			guarantee "REQ_EMU_004_DBC_Emission":
				(active_session and active_profile >= 1 and can_bus_operational and physics_model_updated) => 
					dbc_frames_emitted;

			-- REQ_EMU_005: Processamento de Interrupção de Alta Frequência (Timer2 1ms)
			guarantee "REQ_EMU_005_RX_Polling":
				(can_bus_operational and timer2_1ms_tick) => 
					mcp2515_rx_polled;

			-- REQ_EMU_006: Codificação e Emissão de Resposta OBD-II
			guarantee "REQ_EMU_006_OBD_Response":
				(active_session and obd_request_0x7df_received) => 
					obd_response_0x7e8_sent;

			-- REQ_EMU_007: Latência Média de Resposta OBD-II (Critério AC-02 < 10.0 ms)
			guarantee "REQ_EMU_007_AC02_OBD_Latency":
				(active_session and obd_benchmark_running) => 
					(mean_obd_latency_ms < 10.0);

			-- REQ_EMU_008: Estabilidade Temporal e Jitter de Resposta (Critério AC-03 < 3.0 ms)
			guarantee "REQ_EMU_008_AC03_OBD_Jitter":
				(active_session and obd_benchmark_running) => 
					(latency_jitter_std_ms < 3.0);
		**};
	end Uno_ECU_Emulator;

	system implementation Uno_ECU_Emulator.impl
	end Uno_ECU_Emulator.impl;

	---------------------------------------------------------------------------
	-- 3. SUBSISTEMA 2: AQUISIÇÃO E RECEPÇÃO CAN (ESP32-S3 TWAI - CAMADA MCAL)
	---------------------------------------------------------------------------
	system ESP32_TWAI
		features
			-- Conexão de Hardware (Barramento CAN)
			can_bus_conn: requires bus access CAN_Bus;

			-- Entradas Lógicas (Input Variables do FRET)
			boot_trigger: in data port Base_Types::Boolean;
			mcal_twai_up: in data port Base_Types::Boolean;
			can_frame_arrived: in data port Base_Types::Boolean;
			raw_can_frame_ready: in data port Base_Types::Boolean;
			telemetry_frame_parsed: in data port Base_Types::Boolean;
			can_bus_healthy: in data port Base_Types::Boolean;
			rte_channel_overflow: in data port Base_Types::Boolean;

			-- Saídas Lógicas (Output Variables do FRET)
			twai_async_enabled: out data port Base_Types::Boolean;
			frame_timestamp_captured: out data port Base_Types::Boolean;
			engineering_values_scaled: out data port Base_Types::Boolean;
			rte_channel_pushed: out data port Base_Types::Boolean;
			frame_loss_percentage: out data port Base_Types::Float;
			overflow_logged_and_dropped: out data port Base_Types::Boolean;

		-- ANEXO AGREE: FORMALIZAÇÃO DOS REQUISITOS DO FRET (REQ_CAN_001 a REQ_CAN_006)
		annex agree {**
			-- Variáveis Internas do FRET (Role: Internal)
			eq boot_mode : bool;
			eq active_session : bool;

			-- REQ_CAN_001: Inicialização e Sincronismo do TWAI
			guarantee "REQ_CAN_001_TWAI_Boot":
				(boot_mode and boot_trigger and mcal_twai_up) => twai_async_enabled;

			-- REQ_CAN_002: Captura e Marcação Temporal de Frames
			guarantee "REQ_CAN_002_Timestamp":
				(active_session and can_frame_arrived) => frame_timestamp_captured;

			-- REQ_CAN_003: Conversão de Grandezas Físicas DBC
			guarantee "REQ_CAN_003_DBC_Scale":
				raw_can_frame_ready => engineering_values_scaled;

			-- REQ_CAN_004: Inserção no Canal Assíncrono da RTE
			guarantee "REQ_CAN_004_RTE_Push":
				(active_session and telemetry_frame_parsed) => rte_channel_pushed;

			-- REQ_CAN_005: Cumprimento da Taxa de Recepção (Critério AC-01 <= 1.0%)
			guarantee "REQ_CAN_005_AC01_Frame_Loss":
				(active_session and can_bus_healthy) => (frame_loss_percentage <= 1.0);

			-- REQ_CAN_006: Tratamento Não-Bloqueante de Saturação da RTE
			guarantee "REQ_CAN_006_Overflow_Handling":
				(active_session and rte_channel_overflow) => overflow_logged_and_dropped;
		**};
	end ESP32_TWAI;

	system implementation ESP32_TWAI.impl
	end ESP32_TWAI.impl;

	---------------------------------------------------------------------------
	-- 4. SUBSISTEMA 3: DIAGNÓSTICO ATIVO OBD-II (ESP32-S3 OBD - CAMADA APP)
	---------------------------------------------------------------------------
	system ESP32_OBD
		features
			-- Entradas Lógicas (Input Variables do FRET)
			obd_timer_100ms_expired: in data port Base_Types::Boolean;
			obd_tx_cycle_completed: in data port Base_Types::Boolean;
			obd_timeout_50ms_elapsed: in data port Base_Types::Boolean;
			can_cmd_received_in_queue: in data port Base_Types::Boolean;

			-- Saídas Lógicas (Output Variables do FRET)
			obd_request_0x7df_transmitted: out data port Base_Types::Boolean;
			pid_index_incremented: out data port Base_Types::Boolean;
			obd_timeout_recorded: out data port Base_Types::Boolean;
			can_cmd_interleaved: out data port Base_Types::Boolean;

		-- ANEXO AGREE: FORMALIZAÇÃO DOS REQUISITOS DO FRET (REQ_OBD_001 a REQ_OBD_004)
		annex agree {**
			-- Variáveis Internas do FRET (Role: Internal)
			eq active_session : bool;

			-- REQ_OBD_001: Polling Cíclico de Diagnóstico a 10 Hz
			guarantee "REQ_OBD_001_Polling_10Hz":
				(active_session and obd_timer_100ms_expired) => obd_request_0x7df_transmitted;

			-- REQ_OBD_002: Escalonamento Circular Round-Robin dos PIDs
			guarantee "REQ_OBD_002_Round_Robin":
				(active_session and obd_tx_cycle_completed) => pid_index_incremented;

			-- REQ_OBD_003: Tratamento de Timeout de Diagnóstico (50 ms)
			guarantee "REQ_OBD_003_Timeout":
				(active_session and obd_timeout_50ms_elapsed) => obd_timeout_recorded;

			-- REQ_OBD_004: Intercalação de Comandos de Bancada no Transmissor
			guarantee "REQ_OBD_004_Cmd_Interleave":
				(active_session and can_cmd_received_in_queue) => can_cmd_interleaved;
		**};
	end ESP32_OBD;

	system implementation ESP32_OBD.impl
	end ESP32_OBD.impl;

	---------------------------------------------------------------------------
	-- 5. SUBSISTEMA 4: ESTRUTURAÇÃO DE DADOS E LOGGER (ESP32-S3 LOGGER - CAMADA APP)
	---------------------------------------------------------------------------
	system ESP32_Logger
		features
			-- Entradas Lógicas (Input Variables do FRET)
			telemetry_frame_received: in data port Base_Types::Boolean;
			dataset_recording: in data port Base_Types::Boolean;
			csv_line_available: in data port Base_Types::Boolean;
			flush_timer_2s_expired: in data port Base_Types::Boolean;
			sector_write_chunk: in data port Base_Types::Boolean;
			sd_write_failed: in data port Base_Types::Boolean;
			memory_supervision_active: in data port Base_Types::Boolean;
			heartbeat_timer_60s: in data port Base_Types::Boolean;

			-- Saídas Lógicas (Output Variables do FRET)
			csv_line_formatted: out data port Base_Types::Boolean;
			null_mandatory_fields: out data port Base_Types::Integer;
			sd_buffer_pushed: out data port Base_Types::Boolean;
			flush_signal_emitted: out data port Base_Types::Boolean;
			pending_bytes_flushed: out data port Base_Types::Boolean;
			chunk_preemption_yielded: out data port Base_Types::Boolean;
			ram_backlog_retained: out data port Base_Types::Boolean;
			sram_usage_kb: out data port Base_Types::Float;
			heartbeat_diag_logged: out data port Base_Types::Boolean;

		-- ANEXO AGREE: FORMALIZAÇÃO DOS REQUISITOS DO FRET (REQ_LOG_001 a REQ_LOG_009)
		annex agree {**
			-- Variáveis Internas do FRET (Role: Internal)
			eq active_session : bool;
			eq offline_mode : bool;
			eq buffer_occupancy : int;

			-- REQ_LOG_001: Serialização Determinística em CSV
			guarantee "REQ_LOG_001_CSV_Format":
				(active_session and telemetry_frame_received) => csv_line_formatted;

			-- REQ_LOG_002: Integridade Estrutural do Dataset (AC-04)
			guarantee "REQ_LOG_002_Dataset_Integrity":
				(active_session and dataset_recording) => (null_mandatory_fields = 0);

			-- REQ_LOG_003: Inserção no Buffer Circular em SRAM (4096 bytes)
			guarantee "REQ_LOG_003_Buffer_Push":
				(active_session and csv_line_available) => sd_buffer_pushed;

			-- REQ_LOG_004: Esvaziamento por Limiar de Ocupação (85% = 3584 bytes)
			guarantee "REQ_LOG_004_Flush_Threshold":
				(active_session and buffer_occupancy >= 3584) => flush_signal_emitted;

			-- REQ_LOG_005: Esvaziamento Periódico por Temporizador (2s)
			guarantee "REQ_LOG_005_Flush_Timer":
				(active_session and flush_timer_2s_expired) => pending_bytes_flushed;

			-- REQ_LOG_006: Fatiamento em Chunks de 256 Bytes com Preempção
			guarantee "REQ_LOG_006_Chunk_Yield":
				(active_session and sector_write_chunk) => chunk_preemption_yielded;

			-- REQ_LOG_007: Retenção em Backlog de RAM sob Falha do SD
			guarantee "REQ_LOG_007_RAM_Backlog":
				(offline_mode and sd_write_failed) => ram_backlog_retained;

			-- REQ_LOG_008: Limite de Consumo de Memória SRAM (Critério AC-05 < 200 KB)
			guarantee "REQ_LOG_008_AC05_SRAM_Limit":
				(active_session and memory_supervision_active) => (sram_usage_kb < 200.0);

			-- REQ_LOG_009: Telemetria de Desempenho HEARTBEAT no SD (60s)
			guarantee "REQ_LOG_009_Heartbeat":
				(active_session and heartbeat_timer_60s) => heartbeat_diag_logged;
		**};
	end ESP32_Logger;

	system implementation ESP32_Logger.impl
	end ESP32_Logger.impl;

	---------------------------------------------------------------------------
	-- 6. SUBSISTEMA 5: PERSISTÊNCIA EM CARTÃO MICROSD (ESP32-S3 SD - CAMADA BSW)
	---------------------------------------------------------------------------
	system ESP32_SD
		features
			-- Entradas Lógicas (Input Variables do FRET)
			boot_trigger: in data port Base_Types::Boolean;
			mcal_spi_sd_up: in data port Base_Types::Boolean;
			sd_card_inserted: in data port Base_Types::Boolean;
			session_rotate_command: in data port Base_Types::Boolean;
			new_file_opened: in data port Base_Types::Boolean;
			session_duration_reached: in data port Base_Types::Boolean;
			benchmark_completion: in data port Base_Types::Boolean;

			-- Saídas Lógicas (Output Variables do FRET)
			fat32_filesystem_mounted: out data port Base_Types::Boolean;
			session_file_rotated_atomically: out data port Base_Types::Boolean;
			header_and_boot_lines_written: out data port Base_Types::Boolean;
			session_stopped_and_flushed: out data port Base_Types::Boolean;
			total_dataset_samples: out data port Base_Types::Integer;

		-- ANEXO AGREE: FORMALIZAÇÃO DOS REQUISITOS DO FRET (REQ_SD_001 a REQ_SD_005)
		annex agree {**
			-- Variáveis Internas do FRET (Role: Internal)
			eq boot_mode : bool;
			eq active_session : bool;

			-- REQ_SD_001: Montagem do Sistema de Arquivos FAT32
			guarantee "REQ_SD_001_FAT32_Mount":
				(boot_mode and boot_trigger and mcal_spi_sd_up and sd_card_inserted) => fat32_filesystem_mounted;

			-- REQ_SD_002: Transição Atômica de Arquivos de Sessão
			guarantee "REQ_SD_002_Session_Rotate":
				session_rotate_command => session_file_rotated_atomically;

			-- REQ_SD_003: Injeção de Cabeçalho e Linha BOOT
			guarantee "REQ_SD_003_Header_Boot":
				new_file_opened => header_and_boot_lines_written;

			-- REQ_SD_004: Temporização de Sessão Automática
			guarantee "REQ_SD_004_Session_Timer":
				(active_session and session_duration_reached) => session_stopped_and_flushed;

			-- REQ_SD_005: Volume Consolidado do Dataset (Critério AC-08 >= 72000)
			guarantee "REQ_SD_005_AC08_Dataset_Volume":
				benchmark_completion => (total_dataset_samples >= 72000);
		**};
	end ESP32_SD;

	system implementation ESP32_SD.impl
	end ESP32_SD.impl;

	---------------------------------------------------------------------------
	-- 7. SUBSISTEMA 6: CONECTIVIDADE EM NUVEM E TELEMETRIA (ESP32-S3 TELEMETRY - CAMADA BSW)
	---------------------------------------------------------------------------
	system ESP32_Telemetry
		features
			-- Entradas Lógicas (Input Variables do FRET)
			boot_trigger: in data port Base_Types::Boolean;
			wifi_credentials_configured: in data port Base_Types::Boolean;
			mqtt_credentials_valid: in data port Base_Types::Boolean;
			binary_batch_full: in data port Base_Types::Boolean;
			status_timer_5s: in data port Base_Types::Boolean;
			dispatch_cycle_50ms: in data port Base_Types::Boolean;

			-- Saídas Lógicas (Output Variables do FRET)
			ip_dhcp_assigned: out data port Base_Types::Boolean;
			mqtt_broker_connected: out data port Base_Types::Boolean;
			mqtt_batch_published: out data port Base_Types::Boolean;
			status_json_published: out data port Base_Types::Boolean;
			data_packets_dispatched: out data port Base_Types::Boolean;

		-- ANEXO AGREE: FORMALIZAÇÃO DOS REQUISITOS DO FRET (REQ_COM_001 a REQ_COM_005)
		annex agree {**
			-- Variáveis Internas do FRET (Role: Internal)
			eq boot_mode : bool;
			eq connected_mode : bool;
			eq active_session : bool;

			-- REQ_COM_001: Conexão Wi-Fi e Pilha TCP/IP
			guarantee "REQ_COM_001_WiFi_Connect":
				(boot_mode and boot_trigger and wifi_credentials_configured) => ip_dhcp_assigned;

			-- REQ_COM_005: Estabelecimento de Conexão com o Broker MQTT
			guarantee "REQ_COM_005_MQTT_Connect":
				(boot_mode and ip_dhcp_assigned and mqtt_credentials_valid) => mqtt_broker_connected;

			-- REQ_COM_002: Despacho em Lotes Binários via MQTT (até 150 frames de 18 bytes)
			guarantee "REQ_COM_002_MQTT_Batch_Publish":
				(connected_mode and binary_batch_full) => mqtt_batch_published;

			-- REQ_COM_003: Publicação Periódica de Status e Keepalive (5s)
			guarantee "REQ_COM_003_Status_Publish":
				(connected_mode and status_timer_5s) => status_json_published;

			-- REQ_COM_004: Tarefa Periódica de Despacho BSW Com (Ciclo de 50ms)
			guarantee "REQ_COM_004_Dispatch_Cycle":
				(active_session and dispatch_cycle_50ms) => data_packets_dispatched;
		**};
	end ESP32_Telemetry;

	system implementation ESP32_Telemetry.impl
	end ESP32_Telemetry.impl;

	---------------------------------------------------------------------------
	-- 8. SUBSISTEMA 7: MÁQUINA DE ESTADOS E FALLBACK (ESP32-S3 FSM - CAMADA APP)
	---------------------------------------------------------------------------
	system ESP32_FSM
		features
			-- Entradas Lógicas (Input Variables do FRET)
			wifi_disconnected: in data port Base_Types::Boolean;
			wifi_reconnected: in data port Base_Types::Boolean;

			-- Saídas Lógicas (Output Variables do FRET)
			sd_fallback_active: out data port Base_Types::Boolean;
			backlog_fifo_drained: out data port Base_Types::Boolean;

		-- ANEXO AGREE: FORMALIZAÇÃO DOS REQUISITOS DO FRET (REQ_FSM_001 a REQ_FSM_002)
		annex agree {**
			-- Variáveis Internas do FRET (Role: Internal)
			eq active_session : bool;

			-- REQ_FSM_001: Comutação Automática de Fallback em MicroSD (Critério AC-06 <= 5 ms)
			guarantee "REQ_FSM_001_AC06_SD_Fallback":
				(active_session and wifi_disconnected) => sd_fallback_active;

			-- REQ_FSM_002: Reconexão de Rede e Dreno FIFO de Backlog
			guarantee "REQ_FSM_002_Backlog_Drain":
				(active_session and wifi_reconnected) => backlog_fifo_drained;
		**};
	end ESP32_FSM;

	system implementation ESP32_FSM.impl
	end ESP32_FSM.impl;

	---------------------------------------------------------------------------
	-- 9. SUBSISTEMA 8: COMANDOS REMOTOS E REPLAY (ESP32-S3 CMD - CAMADA APP)
	---------------------------------------------------------------------------
	system ESP32_CMD
		features
			-- Entradas Lógicas (Input Variables do FRET)
			mqtt_cmd_received: in data port Base_Types::Boolean;
			cmd_payload_valid: in data port Base_Types::Boolean;
			bench_injection_requested: in data port Base_Types::Boolean;

			-- Saídas Lógicas (Output Variables do FRET)
			cmd_parsed_and_routed: out data port Base_Types::Boolean;
			invalid_cmd_rejected: out data port Base_Types::Boolean;
			can_frame_interleaved: out data port Base_Types::Boolean;

		-- ANEXO AGREE: FORMALIZAÇÃO DOS REQUISITOS DO FRET (REQ_CMD_001 a REQ_CMD_003)
		annex agree {**
			-- Variáveis Internas do FRET (Role: Internal)
			eq active_session : bool;

			-- REQ_CMD_001: Recepção e Roteamento de Comandos Remotos
			guarantee "REQ_CMD_001_Cmd_Parse":
				(active_session and mqtt_cmd_received and cmd_payload_valid) => cmd_parsed_and_routed;

			-- REQ_CMD_002: Rejeição de Comandos com Payload Inválido
			guarantee "REQ_CMD_002_Cmd_Reject":
				(active_session and mqtt_cmd_received and not cmd_payload_valid) => invalid_cmd_rejected;

			-- REQ_CMD_003: Injeção e Intercalação de Frames CAN de Bancada
			guarantee "REQ_CMD_003_Bench_Interleave":
				(active_session and bench_injection_requested) => can_frame_interleaved;
		**};
	end ESP32_CMD;

	system implementation ESP32_CMD.impl
	end ESP32_CMD.impl;

	---------------------------------------------------------------------------
	-- 10. COLETOR ESP32-S3 (SISTEMA DE TELEMETRIA COMPLETO - COM CONEXÕES INTERNAS)
	---------------------------------------------------------------------------
	system ESP32_Coletor
		features
			can_bus_conn: requires bus access CAN_Bus;
			wifi_connected: in data port Base_Types::Boolean;
			sd_card_present: in data port Base_Types::Boolean;
			active_session: in data port Base_Types::Boolean;
			sd_fallback_active: out data port Base_Types::Boolean;
			can_cmd_received: in data port Base_Types::Boolean;
			can_cmd_interleaved: out data port Base_Types::Boolean;
		annex agree {**
			-- Requisito de Fallback em Nível de Coletor
			guarantee "Modo_Fallback_SD_System":
				(not wifi_connected and active_session) => sd_fallback_active;
		**};
	end ESP32_Coletor;

	system implementation ESP32_Coletor.impl
		subcomponents
			twai_mcal: system ESP32_TWAI.impl;
			obd_app: system ESP32_OBD.impl;
			logger_app: system ESP32_Logger.impl;
			sd_bsw: system ESP32_SD.impl;
			telemetry_bsw: system ESP32_Telemetry.impl;
			fsm_app: system ESP32_FSM.impl;
			cmd_app: system ESP32_CMD.impl;
		connections
			-- Conexão Física ao Barramento CAN
			bus_conn: bus access can_bus_conn <-> twai_mcal.can_bus_conn;

			-- Entradas Externas -> Subsistemas Internos
			conn_sd_present: port sd_card_present -> sd_bsw.sd_card_inserted;
			conn_cmd_in: port can_cmd_received -> cmd_app.mqtt_cmd_received;

			-- Subsistemas Internos -> Saídas Externas
			conn_fallback_out: port fsm_app.sd_fallback_active -> sd_fallback_active;
			conn_interleave_out: port obd_app.can_cmd_interleaved -> can_cmd_interleaved;

			-- Conexões Inter-subsistemas (Fluxo de Dados Interno)
			conn_twai_to_logger: port twai_mcal.engineering_values_scaled -> logger_app.telemetry_frame_received;
			conn_cmd_to_obd: port cmd_app.cmd_parsed_and_routed -> obd_app.can_cmd_received_in_queue;
			conn_wifi_status: port wifi_connected -> fsm_app.wifi_reconnected;
			conn_bench_interleave: port cmd_app.can_frame_interleaved -> obd_app.can_cmd_received_in_queue;
	end ESP32_Coletor.impl;

	---------------------------------------------------------------------------
	-- 11. SISTEMA COMPLETO (TOP LEVEL - CONECTANDO EMULADOR E COLETOR)
	---------------------------------------------------------------------------
	system EdgeTelemetrySystem
	end EdgeTelemetrySystem;

	system implementation EdgeTelemetrySystem.impl
		subcomponents
			can_bus: bus CAN_Bus;
			ecu_emulator: system Uno_ECU_Emulator.impl;
			telemetry_collector: system ESP32_Coletor.impl;
		connections
			bus_conn1: bus access can_bus <-> ecu_emulator.can_bus_conn;
			bus_conn2: bus access can_bus <-> telemetry_collector.can_bus_conn;
	end EdgeTelemetrySystem.impl;

end Sistema_Pkg;