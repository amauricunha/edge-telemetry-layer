package Buses_Pkg
public

	---------------------------------------------------------------------------
	-- PILAR 2: MODELAGEM DOS BARRAMENTOS DE HARDWARE (BUS)
	--
	-- Rastreabilidade com SRS e FRET:
	-- - REQ-SYS-01 / REQ_TWAI_001: Barramento diferencial CAN 2.0B a 500 kbps (AC-01)
	-- - REQ-SYS-16 / REQ_SD_001: Barramento serial SPI2 a 10-20 MHz (AC-03)
	--
	-- Impacto na Análise de Latência do OSATE (Pilar 3.2):
	-- A propriedade Transmission_Time dita o retardo de transmissão física de bits
	-- calculado no relatório Check Flow Latency (ex: 0.266 ms para CAN e 0.321 ms para SPI).
	---------------------------------------------------------------------------

	-- 1. Barramento Automotivo CAN 2.0B Diferencial (500 kbps)
	-- Atende a: REQ-SYS-01, REQ_TWAI_001, REQ_REC_001 e Critério AC-01
	-- Temporização Física:
	-- - Bit rate nominal: 500.000 bits/s => 1 bit = 2.0 us
	-- - Tempo por byte: 8 bits x 2.0 us = 16.0 us/byte (PerByte => 16 us .. 16 us)
	-- - Overhead de framing físico (SOF, CRC, ACK, EOF, IFS): 10 us .. 20 us
	bus CAN_Bus
		properties
			Transmission_Time => [Fixed => 10 us .. 20 us; PerByte => 16 us .. 16 us;];
	end CAN_Bus;

	bus implementation CAN_Bus.impl
	end CAN_Bus.impl;

	-- 2. Barramento Serial Periférico SPI (MicroSD / Memória Flash)
	-- Atende a: REQ-SYS-16, REQ_SD_001 e Critério AC-03
	-- Temporização Física:
	-- - Frequência de clock SPI: 10 MHz a 20 MHz
	-- - Tempo de transferência por byte: ~1 us/byte (PerByte => 1 us .. 1 us)
	-- - Overhead de ativação do Chip Select (/CS) e comandos de bloco: 1 us .. 2 us
	bus SPI_Bus
		properties
			Transmission_Time => [Fixed => 1 us .. 2 us; PerByte => 1 us .. 1 us;];
	end SPI_Bus;

	bus implementation SPI_Bus.impl
	end SPI_Bus.impl;

	-- 3. Barramento Lógico Inter-Core (Memória Compartilhada SRAM Interna)
	-- Atende a: REQ-SYS-31 (Pilar 4 - Comunicação entre Core 0 e Core 1 no ESP32-S3)
	-- Temporização:
	-- - Acesso a registradores de memória RAM compartilhada no clock da CPU (240 MHz)
	-- - Latência ultrabaixa em nanossegundos (Fixed => 100 ns .. 200 ns)
	bus InterCore_Bus
		properties
			Transmission_Time => [Fixed => 100 ns .. 200 ns; PerByte => 20 ns .. 50 ns;];
	end InterCore_Bus;

	bus implementation InterCore_Bus.impl
	end InterCore_Bus.impl;

end Buses_Pkg;
