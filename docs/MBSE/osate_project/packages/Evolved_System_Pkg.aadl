package Evolved_System_Pkg
public
	with Buses_Pkg;
	with Processors_Pkg;
	with CAN_Devices_Pkg;
	with Storage_Devices_Pkg;
	with Comm_Devices_Pkg;
	with Software_Processes_Pkg;
	with TinyML_Pkg;
	with Deployment_Properties;

	---------------------------------------------------------------------------
	-- SISTEMA EVOLUÍDO PILAR 4 (FRAMEWORK CAvA: AIoT EDGE TELEMETRY + DRIVER COACHING)
	---------------------------------------------------------------------------
	system Evolved_EdgeTelemetry_System
	end Evolved_EdgeTelemetry_System;

	system implementation Evolved_EdgeTelemetry_System.impl
		subcomponents
			-- Processador Dual-Core (Core 0: Telemetria BSW | Core 1: TinyML IA)
			cpu: processor Processors_Pkg::ESP32S3_DualCore_Processor.impl;
			can_bus: bus Buses_Pkg::CAN_Bus.impl;
			spi_bus: bus Buses_Pkg::SPI_Bus.impl;

			-- Dispositivos Físicos
			ecu_emulator: device CAN_Devices_Pkg::Uno_ECU_Emulator_Device.impl;
			can_transceiver: device CAN_Devices_Pkg::CAN_Transceiver.impl;
			sd_card: device Storage_Devices_Pkg::MicroSD_Device.impl;
			wifi_module: device Comm_Devices_Pkg::WiFi_Device.impl;

			-- Processos de Software Concorrentes
			sw_telemetry: process Software_Processes_Pkg::Telemetry_Process.immediate_impl;
			sw_tinyml: process TinyML_Pkg::TinyML_Process.impl;
		connections
			-- Conexões de Barramento Físico
			b_can_cpu: bus access can_bus <-> cpu.can_bus_access;
			b_can_transceiver: bus access can_bus <-> can_transceiver.can_bus_conn;
			b_can_emulator: bus access can_bus <-> ecu_emulator.can_bus_conn;
			b_spi_cpu: bus access spi_bus <-> cpu.spi_bus_access;
			b_spi_sd: bus access spi_bus <-> sd_card.spi_conn;

			-- Conexões de Portas Físicas e Lógicas
			p_can_wire: port ecu_emulator.can_tx_out -> can_transceiver.can_tx_frame;
			p_can_to_sw: port can_transceiver.can_rx_frame -> sw_telemetry.can_raw_in;
			p_sw_to_sd: port sw_telemetry.sd_stream_out -> sd_card.file_stream_in;
			p_sw_to_wifi: port sw_telemetry.mqtt_stream_out -> wifi_module.mqtt_stream_in;

			-- Conexão Inter-Processos (Telemetria do Core 0 -> Pipeline TinyML do Core 1)
			p_sw_to_ai: port sw_telemetry.telemetry_for_ai_out -> sw_tinyml.telemetry_in;

			-- Conexão de Saída dos Insights de Driver Coaching para a Nuvem MQTT
			p_ai_to_wifi: port sw_tinyml.coaching_out -> wifi_module.coaching_stream_in;
		flows
			-- Fluxos de Telemetria Tradicional
			end_to_end_can_to_sd: end to end flow can_transceiver.f_source -> p_can_to_sw -> sw_telemetry.f_can_to_sd -> p_sw_to_sd -> sd_card.f_sink;
			end_to_end_can_to_mqtt: end to end flow can_transceiver.f_source -> p_can_to_sw -> sw_telemetry.f_can_to_mqtt -> p_sw_to_wifi -> wifi_module.f_sink_telemetry;

			-- Novo Fluxo Ponta a Ponta de Inteligência de Borda (CAN -> TinyML -> Coaching MQTT)
			end_to_end_can_to_coaching: end to end flow can_transceiver.f_source -> p_can_to_sw -> sw_telemetry.f_can_to_ai -> p_sw_to_ai -> sw_tinyml.f_infer_flow -> p_ai_to_wifi -> wifi_module.f_sink_coaching;
		properties
			-- Amarração de Processador no CORE 0 (Tempo Real Estrito / Aquisição e Armazenamento)
			Actual_Processor_Binding => (reference (cpu.core0)) applies to sw_telemetry;
			Actual_Processor_Binding => (reference (cpu.core0)) applies to sw_telemetry.th_can_rx;
			Actual_Processor_Binding => (reference (cpu.core0)) applies to sw_telemetry.th_obd_poller;
			Actual_Processor_Binding => (reference (cpu.core0)) applies to sw_telemetry.th_logger;
			Actual_Processor_Binding => (reference (cpu.core0)) applies to sw_telemetry.th_tx_dispatch;

			-- Amarração de Processador no CORE 1 (Inteligência de Borda / Inferência TinyML)
			Actual_Processor_Binding => (reference (cpu.core1)) applies to sw_tinyml;
			Actual_Processor_Binding => (reference (cpu.core1)) applies to sw_tinyml.th_adapter;
			Actual_Processor_Binding => (reference (cpu.core1)) applies to sw_tinyml.th_extractor;
			Actual_Processor_Binding => (reference (cpu.core1)) applies to sw_tinyml.th_inference;
			Actual_Processor_Binding => (reference (cpu.core1)) applies to sw_tinyml.th_coach;

			-- Amarração de Barramentos
			Actual_Connection_Binding => (reference (can_bus)) applies to p_can_wire;
			Actual_Connection_Binding => (reference (can_bus)) applies to p_can_to_sw;
			Actual_Connection_Binding => (reference (spi_bus)) applies to p_sw_to_sd;
	end Evolved_EdgeTelemetry_System.impl;

end Evolved_System_Pkg;
